{
  "name": "tokyo-nebula",
  "displayName": "Tokyo Nebula",
  "description": "A VS Code theme family fusing Andromeda's vibrant syntax with Tokyo Night's elegant palette.",
  "version": "0.0.7",
  "publisher": "ni3rav",
  "license": "MIT",
  "author": {
    "name": "ni3rav"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ni3rav/andromeda-night"
  },
  "bugs": {
    "url": "https://github.com/ni3rav/andromeda-night/issues"
  },
  "keywords": [
    "theme",
    "dark theme",
    "tokyo night",
    "andromeda",
    "color-theme"
  ],
  "engines": {
    "vscode": "^1.40.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "contributes": {
    "themes": [
      {
        "label": "Tokyo Nebula",
        "uiTheme": "vs-dark",
        "path": "./themes/tokyo-nebula.json"
      },
      {
        "label": "Tokyo Nebula Italic",
        "uiTheme": "vs-dark",
        "path": "./themes/tokyo-nebula-italic.json"
      },
      {
        "label": "Tokyo Nebula Equalizer",
        "uiTheme": "vs-dark",
        "path": "./themes/equalizer.json"
      },
      {
        "label": "Tokyo Nebula Dusk",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk.json"
      },
      {
        "label": "Tokyo Nebula Operator",
        "uiTheme": "vs-dark",
        "path": "./themes/operator.json"
      }
    ]
  },
  "icon": "images/icon.png"
}
